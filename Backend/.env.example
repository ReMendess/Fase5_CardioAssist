# CardioAssist — credenciais de IBM Watson Assistant
# ---------------------------------------------------------------
# Copie este archivo a `.env` (en la carpeta Backend/) y rellene solo
# lo que necesite sobrescribir. Los valores presentes em Backend/IBM_API.py
# se usan por defecto.
#
# Ejemplo:
#   WATSON_API_KEY=xxxxxxxxxxxxxxxxxxxx
#   WATSON_SERVICE_URL=https://api.xx.assistant.watson.cloud.ibm.com/instances/xxxx
#   WATSON_ASSISTANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   WATSON_ENVIRONMENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

WATSON_API_KEY=
WATSON_SERVICE_URL=
WATSON_ASSISTANT_ID=
WATSON_ENVIRONMENT_ID=